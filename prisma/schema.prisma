generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  INSTRUCTOR
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum ResourceCategory {
  NOTES
  DOCUMENTS
  CERTIFICATES
  OTHER
}

enum ResourceAudience {
  PRIVATE
  STUDENTS
  COURSE
  PROGRAM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MessageActor {
  STUDENT
  STAFF
}

model User {
  id                String                @id @default(cuid())
  clerkUserId       String                @unique
  studentId         String?               @unique
  lmsAccessOverride LmsAccessOverride?
  memberships       BatchMembership[]
  teaching          BatchInstructor[]
  lessonStates      LessonState[]
  role              Role                  @default(STUDENT)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  profile           StudentProfile?
  views             CourseView[]
  enrollments       Enrollment[]
  assignments       ResourceAssignment[]
  tickets           SupportTicket[]
  messages          SupportMessage[]
  referral          ReferralIdentity?
  referred          ReferralAttribution?  @relation("Referred")
  referrals         ReferralAttribution[] @relation("Referrer")

  @@unique([id, role])
}

model StudentProfile {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel String?
  institution    String?
  graduationYear Int?
  interests      String[] @default([])
  careerGoals    String?
  updatedAt      DateTime @updatedAt
}

model Program {
  id        String     @id @default(cuid())
  title     String
  batches   Batch[]
  courses   Course[]
  resources Resource[]
}

model Course {
  id            String       @id @default(cuid())
  title         String
  description   String
  programId     String?
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  thumbnailPath String
  thumbnailAlt  String
  publicPath    String
  published     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  batches       Batch[]
  sections      Section[]
  views         CourseView[]
  enrollments   Enrollment[]
  resources     Resource[]

  @@index([programId])
}

model CourseView {
  userId       String
  courseId     String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastViewedAt DateTime @default(now())

  @@id([userId, courseId])
  @@index([userId, lastViewedAt])
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  courseId   String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId, updatedAt])
  @@index([courseId])
}

model Resource {
  id          String               @id @default(cuid())
  title       String
  description String
  category    ResourceCategory
  mimeType    String
  fileName    String
  fileSize    Int?
  storageKey  String?
  published   Boolean              @default(false)
  audience    ResourceAudience     @default(PRIVATE)
  courseId    String?
  programId   String?
  course      Course?              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  program     Program?             @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  assignments ResourceAssignment[]

  @@index([published, audience])
  @@index([courseId])
  @@index([programId])
}

model ResourceAssignment {
  resourceId String
  userId     String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([resourceId, userId])
  @@index([userId])
}

model SupportTicket {
  id        String           @id @default(cuid())
  reference String           @unique
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  subject   String
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userId, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Restrict)
  actor     MessageActor  @default(STUDENT)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model ReferralIdentity {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())
}

model ReferralAttribution {
  referredUserId String   @id
  referredUser   User     @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrerId     String
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  joinedAt       DateTime @default(now())

  @@index([referrerId, joinedAt])
}

enum LmsAccessOverride {
  ENABLED
  DISABLED
}

enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum LearningItemType {
  LESSON
  QUIZ
  ASSIGNMENT
  RESOURCE
  LIVE_SESSION
  ASSESSMENT
}

enum LessonFormat {
  VIDEO
  TEXT
  PDF
  IMAGE
  EXTERNAL
}

model Batch {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  programId        String?
  program          Program?          @relation(fields: [programId], references: [id], onDelete: Restrict)
  courseId         String?
  course           Course?           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  startsAt         DateTime?         @db.Timestamptz(6)
  endsAt           DateTime?         @db.Timestamptz(6)
  status           BatchStatus       @default(PLANNED)
  lmsAccessEnabled Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      BatchMembership[]
  instructors      BatchInstructor[]

  @@index([programId])
  @@index([courseId])
  @@index([status, startsAt])
}

model BatchMembership {
  id          String           @id @default(cuid())
  batchId     String
  batch       Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  userId      String
  studentRole Role             @default(STUDENT)
  student     User             @relation(fields: [userId, studentRole], references: [id, role], onDelete: Cascade, onUpdate: Restrict)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([userId, batchId])
  @@index([userId, status])
  @@index([batchId, status])
}

model BatchInstructor {
  batchId        String
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  instructorId   String
  instructorRole Role     @default(INSTRUCTOR)
  instructor     User     @relation(fields: [instructorId, instructorRole], references: [id, role], onDelete: Restrict, onUpdate: Restrict)
  assignedAt     DateTime @default(now())

  @@id([batchId, instructorId])
  @@index([instructorId])
}

model Section {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  published   Boolean        @default(false)
  items       LearningItem[]

  @@unique([courseId, position])
}

model LearningItem {
  id        String            @id @default(cuid())
  sectionId String
  section   Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  type      LearningItemType
  position  Int
  published Boolean           @default(false)
  required  Boolean           @default(true)
  resource  LearningResource?
  lesson    Lesson?

  @@unique([sectionId, position])
  @@unique([id, type])
}

model Lesson {
  itemId             String           @id
  itemType           LearningItemType @default(LESSON)
  item               LearningItem     @relation(fields: [itemId, itemType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  structuredContent  Json?
  mimeType           String?
  fileName           String?
  altText            String?
  externalTargetId   String?
  captionsStorageKey String?
  downloadAllowed    Boolean          @default(false)
  states             LessonState[]
  format             LessonFormat
  storageKey         String?
  durationSeconds    Int?

  @@unique([itemId, itemType])
}

model LessonState {
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  lesson          Lesson    @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
  firstAccessedAt DateTime  @default(now()) @db.Timestamptz(6)
  lastAccessedAt  DateTime  @default(now()) @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)

  @@id([userId, itemId])
  @@index([userId, lastAccessedAt])
}

model LearningResource {
  itemId          String           @id
  itemType        LearningItemType @default(RESOURCE)
  item            LearningItem     @relation(fields: [itemId, itemType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  description     String?
  storageKey      String?
  mimeType        String
  fileName        String
  downloadAllowed Boolean          @default(true)

  @@unique([itemId, itemType])
}
