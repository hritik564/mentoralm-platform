generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  INSTRUCTOR
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum ResourceCategory {
  NOTES
  DOCUMENTS
  CERTIFICATES
  OTHER
}

enum ResourceAudience {
  PRIVATE
  STUDENTS
  COURSE
  PROGRAM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MessageActor {
  STUDENT
  STAFF
}

model User {
  id                       String                    @id @default(cuid())
  clerkUserId              String                    @unique
  studentId                String?                   @unique
  lmsAccessOverride        LmsAccessOverride?
  memberships              BatchMembership[]
  teaching                 BatchInstructor[]
  lessonStates             LessonState[]
  academicAttempts         AcademicAttempt[]
  submissions              AssignmentSubmission[]
  attendance               AttendanceRecord[]
  certificates             Certificate[]
  reviews                  AssignmentReview[]
  academicAudit            AcademicAudit[]
  discussionThreads        DiscussionThread[]
  discussionPosts          DiscussionPost[]
  communicationPreferences CommunicationPreference[]
  communicationDeliveries  CommunicationDelivery[]
  communicationMessages    CommunicationMessage[]
  taughtSessions           BatchSession[]            @relation("SessionInstructor")
  roleAssignments          UserRoleAssignment[]
  role                     Role                      @default(STUDENT)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  profile                  StudentProfile?
  views                    CourseView[]
  enrollments              Enrollment[]
  assignments              ResourceAssignment[]
  tickets                  SupportTicket[]
  messages                 SupportMessage[]
  referral                 ReferralIdentity?
  referred                 ReferralAttribution?      @relation("Referred")
  referrals                ReferralAttribution[]     @relation("Referrer")

  @@unique([id, role])
}

model UserRoleAssignment {
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, role])
  @@index([role])
}

model StudentProfile {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel String?
  institution    String?
  graduationYear Int?
  interests      String[] @default([])
  careerGoals    String?
  updatedAt      DateTime @updatedAt
}

model Program {
  id        String     @id @default(cuid())
  title     String
  batches   Batch[]
  courses   Course[]
  resources Resource[]
}

model Course {
  id                        String             @id @default(cuid())
  title                     String
  description               String
  programId                 String?
  program                   Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  thumbnailPath             String
  thumbnailAlt              String
  publicPath                String
  published                 Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  batches                   Batch[]
  sections                  Section[]
  views                     CourseView[]
  enrollments               Enrollment[]
  resources                 Resource[]
  academicCompletionEnabled Boolean            @default(false)
  certificateEnabled        Boolean            @default(false)
  requiredAttendancePercent Float?
  certificates              Certificate[]
  sessions                  BatchSession[]
  discussionThreads         DiscussionThread[]

  @@index([programId])
}

model CourseView {
  userId       String
  courseId     String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastViewedAt DateTime @default(now())

  @@id([userId, courseId])
  @@index([userId, lastViewedAt])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status      EnrollmentStatus @default(ENROLLED)
  completedAt DateTime?        @db.Timestamptz(6)
  enrolledAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId, updatedAt])
  @@index([courseId])
}

model Resource {
  id          String               @id @default(cuid())
  title       String
  description String
  category    ResourceCategory
  mimeType    String
  fileName    String
  fileSize    Int?
  storageKey  String?
  published   Boolean              @default(false)
  audience    ResourceAudience     @default(PRIVATE)
  courseId    String?
  programId   String?
  course      Course?              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  program     Program?             @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  assignments ResourceAssignment[]

  @@index([published, audience])
  @@index([courseId])
  @@index([programId])
}

model ResourceAssignment {
  resourceId String
  userId     String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([resourceId, userId])
  @@index([userId])
}

model SupportTicket {
  id        String           @id @default(cuid())
  reference String           @unique
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  subject   String
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userId, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Restrict)
  actor     MessageActor  @default(STUDENT)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model ReferralIdentity {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())
}

model ReferralAttribution {
  referredUserId String   @id
  referredUser   User     @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrerId     String
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  joinedAt       DateTime @default(now())

  @@index([referrerId, joinedAt])
}

enum LmsAccessOverride {
  ENABLED
  DISABLED
}

enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum LearningItemType {
  LESSON
  QUIZ
  ASSIGNMENT
  RESOURCE
  LIVE_SESSION
  ASSESSMENT
}

enum LessonFormat {
  VIDEO
  TEXT
  PDF
  IMAGE
  EXTERNAL
}

model Batch {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  programId             String?
  program               Program?               @relation(fields: [programId], references: [id], onDelete: Restrict)
  courseId              String?
  course                Course?                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  startsAt              DateTime?              @db.Timestamptz(6)
  endsAt                DateTime?              @db.Timestamptz(6)
  status                BatchStatus            @default(PLANNED)
  lmsAccessEnabled      Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           BatchMembership[]
  instructors           BatchInstructor[]
  sessions              BatchSession[]
  discussionThreads     DiscussionThread[]
  communicationMessages CommunicationMessage[]

  @@index([programId])
  @@index([courseId])
  @@index([status, startsAt])
}

model BatchMembership {
  id          String             @id @default(cuid())
  batchId     String
  batch       Batch              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  userId      String
  studentRole Role               @default(STUDENT)
  student     User               @relation(fields: [userId, studentRole], references: [id, role], onDelete: Cascade, onUpdate: Restrict)
  status      MembershipStatus   @default(ACTIVE)
  joinedAt    DateTime           @default(now())
  leftAt      DateTime?
  updatedAt   DateTime           @updatedAt
  attendance  AttendanceRecord[]

  @@unique([id, userId])
  @@unique([userId, batchId])
  @@index([userId, status])
  @@index([batchId, status])
}

model BatchInstructor {
  batchId        String
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  instructorId   String
  instructorRole Role     @default(INSTRUCTOR)
  instructor     User     @relation(fields: [instructorId, instructorRole], references: [id, role], onDelete: Restrict, onUpdate: Restrict)
  assignedAt     DateTime @default(now())

  @@id([batchId, instructorId])
  @@index([instructorId])
}

model Section {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  published   Boolean        @default(false)
  items       LearningItem[]

  @@unique([courseId, position])
}

model LearningItem {
  id         String            @id @default(cuid())
  sectionId  String
  section    Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title      String
  type       LearningItemType
  position   Int
  published  Boolean           @default(false)
  required   Boolean           @default(true)
  resource   LearningResource?
  lesson     Lesson?
  activity   AcademicActivity?
  assignment Assignment?
  sessions   BatchSession[]

  @@unique([sectionId, position])
  @@unique([id, type])
}

model Lesson {
  itemId             String           @id
  itemType           LearningItemType @default(LESSON)
  item               LearningItem     @relation(fields: [itemId, itemType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  structuredContent  Json?
  mimeType           String?
  fileName           String?
  altText            String?
  externalTargetId   String?
  captionsStorageKey String?
  downloadAllowed    Boolean          @default(false)
  states             LessonState[]
  format             LessonFormat
  storageKey         String?
  durationSeconds    Int?

  @@unique([itemId, itemType])
}

model LessonState {
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String
  lesson          Lesson    @relation(fields: [itemId], references: [itemId], onDelete: Cascade)
  firstAccessedAt DateTime  @default(now()) @db.Timestamptz(6)
  lastAccessedAt  DateTime  @default(now()) @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6)

  @@id([userId, itemId])
  @@index([userId, lastAccessedAt])
}

model LearningResource {
  itemId          String           @id
  itemType        LearningItemType @default(RESOURCE)
  item            LearningItem     @relation(fields: [itemId, itemType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  description     String?
  storageKey      String?
  mimeType        String
  fileName        String
  downloadAllowed Boolean          @default(true)

  @@unique([itemId, itemType])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT
  LONG_TEXT
}

enum AcademicAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum SubmissionKind {
  TEXT
  FILE
  TEXT_AND_FILE
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  ACCEPTED
}

enum SessionStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CertificateStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model QuestionBank {
  id        String     @id @default(cuid())
  title     String
  questions Question[]
}

model Question {
  id          String             @id @default(cuid())
  bankId      String
  bank        QuestionBank       @relation(fields: [bankId], references: [id], onDelete: Restrict)
  type        QuestionType
  prompt      String
  explanation String?
  position    Int
  published   Boolean            @default(false)
  options     QuestionOption[]
  activities  ActivityQuestion[]

  @@unique([bankId, position])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  position   Int
  correct    Boolean  @default(false)

  @@unique([questionId, position])
}

// Quiz and Assessment share execution mechanics; kind is constrained to the actual LearningItem subtype.
model AcademicActivity {
  itemId         String             @id
  itemType       LearningItemType
  item           LearningItem       @relation(fields: [itemId, itemType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  instructions   String
  published      Boolean            @default(false)
  passingPercent Float?
  attemptLimit   Int?
  reviewAnswers  Boolean            @default(false)
  questions      ActivityQuestion[]
  attempts       AcademicAttempt[]

  @@unique([itemId, itemType])
}

model ActivityQuestion {
  activityId String
  activity   AcademicActivity @relation(fields: [activityId], references: [itemId], onDelete: Cascade)
  questionId String
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position   Int
  points     Int              @default(1)

  @@id([activityId, questionId])
  @@unique([activityId, position])
}

model AcademicAttempt {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  activityId     String
  activity       AcademicActivity      @relation(fields: [activityId], references: [itemId], onDelete: Restrict)
  number         Int
  status         AcademicAttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime              @default(now()) @db.Timestamptz(6)
  lastSavedAt    DateTime              @default(now()) @db.Timestamptz(6)
  submittedAt    DateTime?             @db.Timestamptz(6)
  score          Int?
  maxScore       Int?
  percentage     Float?
  passed         Boolean?
  requiresReview Boolean               @default(false)
  passingPercent Float?
  reviewAnswers  Boolean               @default(false)
  responses      AcademicResponse[]

  @@unique([userId, activityId, number])
  @@index([userId, activityId, status])
  @@index([userId, submittedAt(sort: Desc)])
}

// Immutable question/scoring snapshots keep previously started/submitted attempts independent of later authoring.
model AcademicResponse {
  id             String           @id @default(cuid())
  attemptId      String
  attempt        AcademicAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  type           QuestionType
  prompt         String
  explanation    String?
  position       Int
  points         Int
  text           String?
  awardedPoints  Int?
  requiresReview Boolean          @default(false)
  options        ResponseOption[]

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
}

model ResponseOption {
  responseId String
  response   AcademicResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  optionId   String
  label      String
  position   Int
  correct    Boolean
  selected   Boolean          @default(false)

  @@id([responseId, optionId])
  @@unique([responseId, position])
}

model Assignment {
  itemId             String                 @id
  itemType           LearningItemType       @default(ASSIGNMENT)
  item               LearningItem           @relation(fields: [itemId, itemType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)
  instructions       String
  published          Boolean                @default(false)
  dueAt              DateTime?              @db.Timestamptz(6)
  allowedKinds       SubmissionKind[]
  maxFiles           Int                    @default(3)
  maxFileBytes       Int                    @default(5242880)
  requiresAcceptance Boolean                @default(true)
  allowResubmission  Boolean                @default(true)
  submissions        AssignmentSubmission[]

  @@unique([itemId, itemType])
}

model AssignmentSubmission {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignmentId String
  assignment   Assignment          @relation(fields: [assignmentId], references: [itemId], onDelete: Restrict)
  versions     SubmissionVersion[]

  @@unique([userId, assignmentId])
}

model SubmissionVersion {
  id           String               @id @default(cuid())
  submissionId String
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  number       Int
  requestKey   String
  submittedAt  DateTime             @default(now()) @db.Timestamptz(6)
  kind         SubmissionKind
  text         String?
  status       SubmissionStatus     @default(SUBMITTED)
  files        SubmissionFile[]
  reviews      AssignmentReview[]

  @@unique([submissionId, number])
  @@unique([submissionId, requestKey])
}

model SubmissionFile {
  id         String            @id @default(cuid())
  versionId  String
  version    SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  bytes      Int
  storageKey String            @unique
}

model AssignmentReview {
  id         String            @id @default(cuid())
  versionId  String
  version    SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  reviewerId String
  reviewer   User              @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  status     SubmissionStatus
  feedback   String
  reviewedAt DateTime          @default(now()) @db.Timestamptz(6)

  @@index([versionId, reviewedAt])
}

model BatchSession {
  id               String             @id @default(cuid())
  batchId          String
  batch            Batch              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  title            String
  startsAt         DateTime           @db.Timestamptz(6)
  endsAt           DateTime           @db.Timestamptz(6)
  courseId         String?
  course           Course?            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  itemId           String?
  item             LearningItem?      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  status           SessionStatus      @default(SCHEDULED)
  locationLabel    String?
  externalTargetId String?
  attendance       AttendanceRecord[]

  instructorId String?
  instructor   User?                  @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recording    BatchSessionRecording?

  @@index([instructorId])
  @@index([batchId, startsAt])
}

model AttendanceRecord {
  sessionId    String
  session      BatchSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  membershipId String
  userId       String
  membership   BatchMembership  @relation(fields: [membershipId, userId], references: [id, userId], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status       AttendanceStatus
  recordedAt   DateTime         @default(now()) @db.Timestamptz(6)

  @@id([sessionId, userId])
  @@index([userId])
}

model Certificate {
  id         String            @id @default(cuid())
  code       String            @unique
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId   String
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  issuedAt   DateTime          @default(now()) @db.Timestamptz(6)
  status     CertificateStatus @default(ACTIVE)
  storageKey String?
  fileName   String?
  mimeType   String?

  @@unique([userId, courseId])
}

model AcademicAudit {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  details   Json?
  targetId  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([targetId, createdAt])
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

enum CommunicationPurpose {
  OPERATIONAL
  MARKETING
}

enum CommunicationDeliveryStatus {
  PENDING_PROVIDER
  SUPPRESSED
}

model CommunicationPreference {
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel   CommunicationChannel
  purpose   CommunicationPurpose
  allowed   Boolean              @default(false)
  evidence  String
  updatedAt DateTime             @updatedAt

  @@id([userId, channel, purpose])
}

model CommunicationMessage {
  id          String                  @id @default(cuid())
  batchId     String
  batch       Batch                   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  initiatorId String
  initiator   User                    @relation(fields: [initiatorId], references: [id], onDelete: Restrict)
  channel     CommunicationChannel
  purpose     CommunicationPurpose
  subject     String
  body        String
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  deliveries  CommunicationDelivery[]

  @@index([batchId, createdAt])
}

model CommunicationDelivery {
  messageId String
  message   CommunicationMessage        @relation(fields: [messageId], references: [id], onDelete: Restrict)
  userId    String
  user      User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    CommunicationDeliveryStatus
  reason    String
  queuedAt  DateTime                    @default(now()) @db.Timestamptz(6)

  @@id([messageId, userId])
  @@index([userId, queuedAt])
}

model DiscussionThread {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchId   String?
  batch     Batch?           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title     String
  locked    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @db.Timestamptz(6)
  posts     DiscussionPost[]

  @@index([courseId, updatedAt])
  @@index([batchId, updatedAt])
}

model DiscussionPost {
  id        String           @id @default(cuid())
  threadId  String
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([threadId, createdAt, id])
}

// Durable facts recorded transactionally; no notification worker or provider is enabled.
model LearningEvent {
  id         String   @id @default(cuid())
  kind       String
  key        String   @unique
  subjectId  String
  courseId   String?
  userId     String?
  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([kind, occurredAt])
}

enum BatchSessionRecordingStatus {
  UPLOADING
  PROCESSING
  READY
  PUBLISHED
  FAILED
}

model BatchSessionRecording {
  sessionId          String                      @id
  session            BatchSession                @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision           String                      @unique @default(uuid()) @db.Uuid
  storageProvider    String
  assetRef           String?
  title              String?
  description        String?
  fileName           String?
  mimeType           String?
  bytes              BigInt?
  durationSeconds    Int?
  status             BatchSessionRecordingStatus @default(UPLOADING)
  readyAt            DateTime?                   @db.Timestamptz(6)
  publishedAt        DateTime?                   @db.Timestamptz(6)
  cleanupRequestedAt DateTime?                   @db.Timestamptz(6)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(6)

  @@unique([storageProvider, assetRef])
  @@index([status, updatedAt])
  @@index([cleanupRequestedAt])
}
