{
  "name": "mentoralm-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/production/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:d1": "playwright test --config=playwright.d1.config.ts",
    "test:d2": "playwright test --config=playwright.d2.config.ts",
    "test:d3": "playwright test --config=playwright.d3.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx scripts/production/refuse.ts",
    "db:migrate:dev": "tsx scripts/production/refuse.ts",
    "prebuild": "prisma generate",
    "postinstall": "prisma generate",
    "test:d4:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/d4-domain.test.ts",
    "test:d4": "playwright test --config=playwright.d4.config.ts",
    "test:l1:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/l1-domain.test.ts",
    "test:l1": "playwright test --config=playwright.l1.config.ts",
    "test:l2:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/l2-domain.test.ts",
    "test:l2": "playwright test --config=playwright.l2.config.ts",
    "test:l3:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/l3-domain.test.ts",
    "test:l3": "playwright test --config=playwright.l3.config.ts",
    "test:l4:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/l4-domain.test.ts",
    "test:l4": "playwright test --config=playwright.l4.config.ts",
    "dev:lms-seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/lms-owner/seed.ts",
    "test:a1:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/admin-a1-domain.test.ts tests/admin-a1-migration.test.ts",
    "test:a1": "playwright test --config=playwright.admin-a1.config.ts",
    "db:migrate:a1:local": "tsx scripts/admin-a1/migrate.ts",
    "dev:admin-role": "NODE_OPTIONS=--conditions=react-server tsx scripts/admin-owner/roles.ts",
    "test:admin-owner": "playwright test --config=playwright.admin-owner.config.ts",
    "test:roles:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/admin-roles-domain.test.ts tests/admin-roles-migration.test.ts",
    "test:a2:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/admin-a2-domain.test.ts",
    "test:a2": "playwright test --config=playwright.admin-a2.config.ts",
    "dev:academic-media-reconcile": "NODE_OPTIONS=--conditions=react-server tsx scripts/admin-owner/reconcile-media.ts",
    "test:a3:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/admin-a3-domain.test.ts tests/admin-a3-migration.test.ts",
    "test:a3": "playwright test --config=playwright.admin-a3.config.ts",
    "db:migrate:a3:local": "tsx scripts/admin-a3/migrate.ts",
    "test:a4:domain": "NODE_OPTIONS=--conditions=react-server tsx --test tests/admin-a4-domain.test.ts",
    "test:a4": "playwright test --config=playwright.admin-a4.config.ts",
    "db:migrate:a4:local": "tsx scripts/admin-a4/migrate.ts",
    "dev:admin-governance": "NODE_OPTIONS=--conditions=react-server tsx scripts/admin-owner/governance.ts",
    "prod:preflight": "tsx scripts/production/offline-preflight.ts",
    "prod:db:preflight": "tsx scripts/production/database.ts preflight",
    "prod:db:deploy": "tsx scripts/production/database.ts deploy",
    "prod:db:status": "tsx scripts/production/database.ts status",
    "test:p1": "NODE_OPTIONS=--conditions=react-server tsx --test tests/production-p1.test.ts",
    "test:p1:runtime": "NODE_OPTIONS=--conditions=react-server tsx --test tests/production-p1-runtime.test.ts",
    "test:p1:providers": "NODE_OPTIONS=--conditions=react-server tsx --test tests/production-providers.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.8",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.3.7",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@clerk/backend": "^3.21.0",
    "@clerk/testing": "^2.2.40",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.7",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
