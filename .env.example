# Optional approved public origin. Leave unset locally; canonical metadata is omitted.
# NEXT_PUBLIC_SITE_URL=https://mentoralm.com
# L1 domain deployment: configure both origins together, then rebuild.
# Leave LMS origin unset for local same-host /learn development.
# NEXT_PUBLIC_LMS_ORIGIN=https://students.mentoralm.com

# D1: same Clerk instance across Website and Dashboard. Use a development instance locally.
# Copy these from the Clerk Dashboard into ignored .env.local; never commit keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Sign-in/sign-up paths and safe dashboard redirects are configured in code.
# L4: live keys require BOTH approved production origins above and a fresh build.
# One Clerk production instance serves Website, Dashboard and LMS; no second auth store.

# D4 PostgreSQL. Add real development credentials only to ignored .env.local.
DATABASE_URL=
# Dedicated disposable test database; never production. Test names must end _test.
TEST_DATABASE_URL=
# Explicitly opt in to migration/integration tests on that disposable database.
ALLOW_DATABASE_TESTS=0
# Approved HTTPS origin for real referral share URLs (no path/query/credentials).
REFERRAL_APP_ORIGIN=
# Optional Admin-controlled private filesystem directory. Keep outside public/.
# No resource upload API is implemented; unconfigured storage disables resource actions.
RESOURCE_FILES_ROOT=

# L2: separate operator-controlled private lesson/resource storage outside public/.
# Unset provider means honest unavailable media; no runtime fixture files are created.
LMS_FILES_ROOT=
# Optional deployment-owned external target registry. DB stores target IDs, not URLs.
# LMS_EXTERNAL_LINKS={"approved-target":"https://approved.example/course"}
# LMS_EXTERNAL_ORIGINS=https://approved.example
LMS_EXTERNAL_LINKS=
LMS_EXTERNAL_ORIGINS=

# Optional private assignment upload root (pre-created, outside public/).
LMS_SUBMISSIONS_ROOT=
