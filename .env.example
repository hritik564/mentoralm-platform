# Optional approved public origin. Leave unset locally; canonical metadata is omitted.
# NEXT_PUBLIC_SITE_URL=https://mentoralm.com
# L1 domain deployment: configure both origins together, then rebuild.
# Leave LMS origin unset for local same-host /learn development.
# NEXT_PUBLIC_LMS_ORIGIN=https://students.mentoralm.com

# D1: same Clerk instance across Website and Dashboard. Use a development instance locally.
# Copy these from the Clerk Dashboard into ignored .env.local; never commit keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Sign-in/sign-up paths and safe dashboard redirects are configured in code.
# P1: live keys require ALL THREE exact approved production origins and a fresh build.
# One Clerk production instance serves Website, Dashboard, LMS and Admin; no second auth store.

# D4 PostgreSQL. Add real development credentials only to ignored .env.local.
DATABASE_URL=
# Dedicated disposable test database; never production. Test names must end _test.
TEST_DATABASE_URL=
# Explicitly opt in to migration/integration tests on that disposable database.
ALLOW_DATABASE_TESTS=0
# Approved HTTPS origin for real referral share URLs (no path/query/credentials).
REFERRAL_APP_ORIGIN=
# Optional Admin-controlled private filesystem directory. Keep outside public/.
# No resource upload API is implemented; unconfigured storage disables resource actions.
RESOURCE_FILES_ROOT=

# L2: separate operator-controlled private lesson/resource storage outside public/.
# Unset provider means honest unavailable media; no runtime fixture files are created.
LMS_FILES_ROOT=
# Optional deployment-owned external target registry. DB stores target IDs, not URLs.
# LMS_EXTERNAL_LINKS={"approved-target":"https://approved.example/course"}
# LMS_EXTERNAL_ORIGINS=https://approved.example
LMS_EXTERNAL_LINKS=
LMS_EXTERNAL_ORIGINS=

# Optional private assignment upload root (pre-created, outside public/).
LMS_SUBMISSIONS_ROOT=

# A1: same application, Clerk instance and database; leave unset for local /admin.
# NEXT_PUBLIC_ADMIN_ORIGIN=https://admin.mentoralm.com
# A1 recording storage has no installed upload/processing adapter.
# Uploads remain disabled until a private provider with readiness, cleanup,
# revision reconciliation and controlled delivery is integrated. No video URLs/keys belong here.

# P1: explicit classification. This template is LOCAL; Production secrets come from
# the future hosting secret manager, not a committed/copied .env.local file.
MENTORALM_ENV=local
# Production requires MENTORALM_ENV=production, NODE_ENV=production and all THREE
# exact approved HTTPS origins above. One live Clerk instance for mentoralm.com.
# Production secret values are intentionally blank and must never be pasted in chat.
PRODUCTION_DATABASE_NAME=
# Separate direct/operator URL to the SAME database, never an LMS/Admin database.
# Required by explicit prod:db:* commands only. Credentials supplied securely.
MIGRATION_DATABASE_URL=
# Production URL requirements: schema=public, sslmode=require, sslaccept=strict.
# Runtime explicitly verifies TLS with the system CA and hostname. No TLS bypass.
DATABASE_POOL_MAX=8
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
# LOCAL template only. Production must override RATE_LIMIT_BACKEND=upstash;
# missing/unavailable Upstash rejects sensitive writes and readiness, with no local fallback.
RATE_LIMIT_BACKEND=process-local
# Enable short HSTS only AFTER ingress HTTPS is verified. No preload/subdomain flag.
PRODUCTION_HTTPS_CONFIRMED=0

# P1 providers: Replit compute only; independent direct Neon Singapore database.
# Never attach a Replit managed DB or adopt Neon/Replit Auth.
# These credentials must remain blank locally; enter future values in deployment secrets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BETTER_STACK_INGEST_URL=
BETTER_STACK_SOURCE_TOKEN=
# Optional exact generated replit.app hostname: only infrastructure probes are allowed.
REPLIT_BOOTSTRAP_HOST=
# Runtime honors injected PORT or defaults 3000; .replit internal port must match.
# PORT=3000
# Neon runtime AND migration URLs must be direct (no -pooler), same DB/endpoint,
# AWS ap-southeast-1. MIGRATION_DATABASE_URL is for a separate operator job, not the web VM.
