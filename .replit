modules = ["nodejs-22"]

# Autoscale production runtime. Use independent Neon DATABASE_URL only.
# Replit may inject PG* variables even when its managed database is not used;
# strip those provider variables before build/start so the production guard
# sees only the approved explicit DATABASE_URL.
[deployment]
build = ["sh", "-c", "unset PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD PGOPTIONS; npm ci --include=dev && npm run build"]
run = ["sh", "-c", "unset PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD PGOPTIONS; exec npm run start"]
ignorePorts = false

[[ports]]
localPort = 3000
externalPort = 80
