modules = ["nodejs-22"]

# Preparation only. Select Autoscale / Asia and deployment secrets manually after owner approval.
# Never attach Replit's managed database; DATABASE_URL is the independent Neon binding.
[deployment]
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["npm", "run", "start"]
ignorePorts = false

[[ports]]
localPort = 3000
externalPort = 80
